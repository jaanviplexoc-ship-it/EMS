# Copy this file to ".env" and update the port to match your running .NET API.
# Since the backend has no launchSettings.json, check the console output when
# you run "dotnet run" for the actual port (commonly http://localhost:5000 or
# https://localhost:7000-ish). Include /api at the end.
VITE_API_BASE_URL=http://localhost:5000/api
